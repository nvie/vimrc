{
  // Astro has no coc extension, so the language server is wired up directly.
  //
  //   npm install -g @astrojs/language-server
  //
  // npm and not pnpm: pnpm's strict node_modules layout breaks a transitive
  // require inside the server's bundled yaml-language-server, and it dies on
  // startup with "Cannot find module 'jsonc-parser'".
  //
  // The server refuses to initialize without being handed a TypeScript SDK,
  // and it cannot use this repo's own: TypeScript 7 is the Go port and ships
  // only tsc.js, where Volar needs typescript.js. So the SDK is a dedicated
  // 5.x that no project or node upgrade can move:
  //
  //   mkdir -p ~/.local/share/astro-ls && cd ~/.local/share/astro-ls
  //   npm init -y && npm install typescript@5
  "languageserver": {
    "astro": {
      "command": "astro-ls",
      "args": ["--stdio"],
      "filetypes": ["astro"],
      "rootPatterns": ["astro.config.mjs", "astro.config.ts", "package.json"],
      "initializationOptions": {
        "typescript": {
          "tsdk": "/Users/nvie/.local/share/astro-ls/node_modules/typescript/lib"
        }
      }
    }
  },

  "eslint.enable": true,
  "eslint.rules.customizations": [
    // Turn off lint warnings in Vim for "XXX" comments
    // I still want to see those in CI, but not in my editor constantly
    {
      "rule": "no-warning-comments",
      "severity": "off"
    }
  ]
}
